<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6F8">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#4A3480"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←  Registrar entrada"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contenido desplazable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tarjeta informativa verde -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E8F5E9"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⬆ Entrada de inventario"
                    android:textColor="#2E7D32"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="El stock del producto aumentará"
                    android:textColor="#4CAF50"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Campo Producto -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Producto"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#FFFFFF"
                android:text="  Seleccionar producto..."
                android:gravity="center_vertical"
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:paddingEnd="12dp"/>

            <!-- Campo Cantidad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cantidad"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#FFFFFF"
                android:hint="0"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <!-- Campo Proveedor -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Proveedor"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#FFFFFF"
                android:hint="Nombre del proveedor"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <!-- Campo Fecha -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#FFFFFF"
                android:hint="dd/mm/aaaa"
                android:inputType="date"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <!-- Campo Observación -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Observación (opcional)"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="#FFFFFF"
                android:hint="Notas adicionales..."
                android:inputType="textMultiLine"
                android:gravity="top"
                android:padding="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"/>

            <!-- Botón Registrar -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="✓ Registrar entrada"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4CAF50"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>